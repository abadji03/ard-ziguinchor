# URL de la base PostgreSQL
# - Local    : votre PostgreSQL local
# - Render   : Internal Database URL (render PostgreSQL) — utiliser la chaîne
#              fournie par Render avec ?sslmode=require si nécessaire
DATABASE_URL="postgresql://user:password@host:5432/bd_ard_zig?schema=public"

# Origines autorisées (CORS) — séparées par des virgules
# En prod : l'URL Vercel du frontend (+ éventuellement un domaine custom)
CORS_ORIGIN=http://localhost:3001

# Application
NODE_ENV=development
PORT=3000

# JWT — CHANGER IMPÉRATIVEMENT EN PRODUCTION (longue chaîne aléatoire)
JWT_SECRET=changer-cette-valeur-en-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (upload d'images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (emails)
RESEND_API_KEY=

# Redis (optionnel) — si vide/non défini, cache mémoire utilisé
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
